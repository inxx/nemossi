# Waveshare ESP32-S3-Touch-LCD-1.54, factory source:
# https://github.com/waveshareteam/ESP32-S3-Touch-LCD-1.54/tree/5157db7c888e476fd57f8a95020800377447478f
# Load after the pinned Muse SDK's sdkconfig.defaults, using ESP-IDF 6.0.1.
CONFIG_IDF_TARGET="esp32s3"
CONFIG_HOMEHUB_LED_BACKEND_NEMOSSI=y
CONFIG_HOMEHUB_BUTTON_GPIO=4
CONFIG_HOMEHUB_VOICE=y
CONFIG_CODEC_ES7210_SUPPORT=y
CONFIG_CODEC_ES8311_SUPPORT=y
# CONFIG_MUSE_ENABLED is not set
CONFIG_HOMEHUB_BLE_NAME_PREFIX="MuseGadget-Nemossi"
# CONFIG_HOMEHUB_TUNNEL is not set
# CONFIG_HOMEHUB_OTA_ENABLED is not set
# CONFIG_HOMEHUB_SUPPORT_BUG_REPORT is not set
# CONFIG_HOMEHUB_DEV_BUILD is not set
CONFIG_GADGET_SDK_TOKEN=""
CONFIG_HOMEHUB_WIFI_SSID=""
CONFIG_HOMEHUB_WIFI_PASSWORD=""
CONFIG_NEMOSSI_TTS_URL=""
CONFIG_NEMOSSI_TTS_TOKEN=""

CONFIG_ESPTOOLPY_FLASHMODE_DIO=y
CONFIG_ESPTOOLPY_FLASHFREQ_80M=y
CONFIG_ESPTOOLPY_FLASHSIZE_16MB=y
CONFIG_ESPTOOLPY_FLASHSIZE="16MB"
CONFIG_PARTITION_TABLE_CUSTOM=y
CONFIG_PARTITION_TABLE_CUSTOM_FILENAME="partitions-nemossi.csv"
CONFIG_PARTITION_TABLE_OFFSET=0x8000
# CONFIG_ESP_PHY_INIT_DATA_IN_PARTITION is not set
# CONFIG_BOOTLOADER_APP_ROLLBACK_ENABLE is not set
CONFIG_MMU_PAGE_SIZE_64KB=y

CONFIG_SPIRAM=y
CONFIG_SPIRAM_MODE_OCT=y
CONFIG_SPIRAM_SPEED_80M=y
CONFIG_SPIRAM_ALLOW_STACK_EXTERNAL_MEMORY=y
CONFIG_SPIRAM_TRY_ALLOCATE_WIFI_LWIP=y
CONFIG_ESP32S3_INSTRUCTION_CACHE_32KB=y
CONFIG_ESP32S3_DATA_CACHE_64KB=y
CONFIG_ESP_CONSOLE_USB_SERIAL_JTAG=y

# These options must remain off; the prepare/build checks reject enabling them.
# CONFIG_HOMEHUB_NVS_ENCRYPTION is not set
# CONFIG_NVS_ENCRYPTION is not set
# CONFIG_HOMEHUB_PAIRING_EFUSE_AUTH is not set
# CONFIG_SECURE_BOOT is not set
# CONFIG_SECURE_FLASH_ENC_ENABLED is not set
# CONFIG_SECURE_SIGNED_APPS_NO_SECURE_BOOT is not set
# CONFIG_SECURE_SIGNED_ON_UPDATE_NO_SECURE_BOOT is not set
# CONFIG_SECURE_BOOT_BUILD_SIGNED_BINARIES is not set
